+static gboolean
+template_table_is_valid (FpiDeviceRealtek *self)
+{
+  if (!self->read_data ||
+      self->template_num <= 0 ||
+      self->template_len != TEMPLATE_LEN_COMMON ||
+      self->trans_data_len != (gsize) self->template_num * self->template_len)
+    return FALSE;
+
+  for (gint i = 0; i < self->template_num; i++)
+    {
+      const guint8 *slot = self->read_data + (i * self->template_len);
+
+      if (slot[0] == 0)
+        continue;
+
+      if (slot[0] != 1 ||
+          slot[SUBFACTOR_OFFSET] != SUB_FINGER_01 ||
+          slot[UID_OFFSET] == 0 ||
+          slot[UID_OFFSET] == ' ')
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
 static void
 fp_cmd_receive_cb (FpiUsbTransfer *transfer,
                    FpDevice       *device,
@@ -666,11 +693,31 @@
 
   /* get status */
   status_flag = parse_status (transfer->buffer, self->message_type);
+
+  /*
+   * The 3274:9011 firmware returns status 0x01 after a successful template
+   * table read.  Older Realtek MOC variants return 0x00.  Accept the alternate
+   * status only when the whole table is present and every occupied slot has a
+   * valid record header, so truncated and malformed responses remain errors.
+   */
+  if (status_flag == 0x01 &&
+      (fpi_device_get_driver_data (device) & FP_RTK_QUIRK_TEMPLATE_STATUS_ONE) &&
+      data->command_class == 0x45 &&
+      data->command_code == 0x0e &&
+      template_table_is_valid (self))
+    {
+      fp_info ("Valid template table reported with status 0x01; accepting variant status");
+      status_flag = 0;
+    }
+
   if (status_flag != 0)
     {
       fpi_ssm_mark_failed (transfer->ssm,
                            fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
-                                                     "Status check failed"));
+                                                     "Status check failed for command %02x %02x (0x%02x)",
+                                                     data->command_class,
+                                                     data->command_code,
+                                                     status_flag));
       return;
     }
 
